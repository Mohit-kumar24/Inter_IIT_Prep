# Local workflow settings read by setup.ps1. No secrets are required.
FJSP_BOOTSTRAP_PYTHON=python
FJSP_CXX=g++
FJSP_BUILD_FLAGS=-O3 -std=c++17
FJSP_PART_D_TIMEOUT=180
FJSP_GENERATE_JOBS=10
FJSP_GENERATE_MACHINES=5
FJSP_GENERATE_SEEDS=1,2,3
FJSP_GENERATE_OUTPUT=instances/generated_batch
FJSP_GENERATE_CLASSES=
FJSP_GENERATE_PLOTS=false
