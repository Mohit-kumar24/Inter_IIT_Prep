# Local-only configuration; commit .env.example, never local overrides.
/.env
!/.env.example

# Python environments and generated bytecode.
/.venv/
/env/.venv/
__pycache__/
*.py[cod]

# Native build products.
*.exe
*.o
*.obj

# Explicitly excluded project material.
/LEFT/
/docs/archive/

# Keep only the finished PDF from the report working directory.
/docs/report/*
!/docs/report/Report.pdf
